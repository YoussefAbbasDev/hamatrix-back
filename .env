# HAMATRIX — إعدادات الخادم (Backend)
# هذا الملف يخص الخادم فقط. الواجهة لها ملفها في client/.env
# لا ترفع هذا الملف إلى Git — انسخ منه server/.env.example

# ─── التشغيل ────────────────────────────────────────────────────────────────
NODE_ENV=development
# منفذ الـ API. واجهة التطوير تمرّر /api و/uploads و/socket.io إلى هنا.
PORT=4010
# أصل الواجهة المسموح له بالاتصال (CORS + كوكي التحديث).
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── قاعدة البيانات ─────────────────────────────────────────────────────────
# replica set مطلوب لأن كل العمليات المالية داخل معاملات MongoDB.
# MongoDB Atlas (سحابي) — العنقود نفسه replica set، فالمعاملات تعمل.
MONGODB_URI=mongodb+srv://youssefabbas722_db_user:5XQ96iZBc9fezdNZ@cluster0.psv50ye.mongodb.net/hamatrix?retryWrites=true&w=majority

# ─── المصادقة ───────────────────────────────────────────────────────────────
# غيّر هذا السر قبل أي تشغيل خارج جهاز التطوير.
# توليد سر جديد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-please-0123456789abcdef0123456789
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# ─── المدير الأول (يُستخدم مرة واحدة عند أول تشغيل) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_DISPLAY_NAME=المدير

# ─── متفرقات ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# مجلد الشعار والصور، نسبي إلى مجلد server/
UPLOAD_DIR=uploads
SEED_DEMO=false
