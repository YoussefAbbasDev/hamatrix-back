# HAMATRIX — server environment
# Copy this file to server/.env and adjust the values.
# This file configures the API only; the frontend has its own client/.env.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# API port. The Vite dev server proxies /api, /uploads and /socket.io here.
PORT=4000
# Origin allowed to call the API (CORS + refresh cookie).
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database (MongoDB replica set is required for transactions) ────────────
# Local dev with `npm run db:dev` (embedded mongod on port 27017, replica set rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/hamatrix?replicaSet=rs0
# Docker alternative: mongodb://127.0.0.1:27017/hamatrix?replicaSet=rs0&directConnection=true
# MongoDB Atlas (cloud): the cluster is already a replica set.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hamatrix?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me-please-0123456789abcdef0123456789
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# ─── First-run admin (change from Settings after first login) ───────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_DISPLAY_NAME=المدير

# ─── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Upload folder for the café logo, relative to the server/ directory.
UPLOAD_DIR=uploads
SEED_DEMO=false
